 "rules": [
  {
   "id": "CFTR-1",
   "gene": "CFTR",
   "version": 1,
   "statement": "Isolated congenital bilateral absence of the vas deferens (CFTR-CBAVD), a CFTR-related disorder without additional clinical manifestations of cystic fibrosis, usually results from compound heterozygosity for a severe loss-of-function CFTR variant with a non-CF-causing variant or two non-CF-causing variants.",
   "applies_when": {
    "zygosity": [
     "heterozygous"
    ]
   },
   "effect": {
    "type": "diagnosis",
    "supports": [
     "OMIM:277180"
    ],
    "argues_against": [
     "OMIM:219700"
    ]
   },
   "exceptions": "The text states that a small percentage of individuals diagnosed with isolated CFTR-CBAVD develop adult-onset respiratory or pancreatic disease; the genotype described is compound heterozygosity, not simple heterozygosity.",
   "sources": [
    {
     "type": "nbk",
     "id": "NBK1250",
     "url": "https://www.ncbi.nlm.nih.gov/books/NBK1250/",
     "accessed_at": 1793707716,
     "section": "Genetically Related (Allelic) Disorders",
     "credit": "GeneReviews® © 1993-2026 University of Washington, Seattle (https://www.genereviews.org); excerpt reproduced verbatim for noncommercial research",
     "quote": "CFTR-related disorders (CFTR-RD) include disorders associated with biallelic CFTR pathogenic variants but without additional clinical manifestations of CF [Simmonds et al 2024]. CFTR-related isolated congenital bilateral absence of the vas deferens (CFTR-CBAVD) is the most common CFTR-RD. Isolated CBAVD usually results from compound heterozygosity for a severe loss-of-function CFTR variant with a non-CF-causing variant (e.g., c.1210-12T[5]) or two non-CF-causing variants (see Molecular Genetics, Genetic Modifiers). A small percentage of individuals diagnosed with isolated CFTR-CBAVD develop adult-onset respiratory or pancreatic disease [Cui et al 2020, Fedder et al 2021, Cai & Li 2022].",
     "quote_verified": true
    }
   ],
