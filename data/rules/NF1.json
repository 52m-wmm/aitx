   "sources": [
    {
     "type": "pmid",
     "id": "36612057",
     "url": "https://pubmed.ncbi.nlm.nih.gov/36612057/",
     "accessed_at": 1793708885,
     "text_url": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&id=36612057&rettype=abstract&retmode=text",
     "quote": "The proportion of missense mutations was higher in the SNF cases than in the classical NF1 group (21.40% vs. 7.5%, p = 0.007), conferring an odds ratio (OR) of 3.34 (CI = 1.33−10.78).",
     "quote_verified": true
    },
    {
     "type": "pmid",
     "id": "25211147",
     "url": "https://pubmed.ncbi.nlm.nih.gov/25211147/",
     "accessed_at": 1793708888,
     "text_url": "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&id=25211147&rettype=abstract&retmode=text",
     "quote": "The risk of developing SNF vs NF1 was increased for missense mutations [p = 0.0001; odds ratio (OR) = 6.16; confidence interval (CI) = 3.14-13.11], which were more frequent in SNF vs MNFSR (p = 0.0271).",
     "quote_verified": true
    }
   ],
